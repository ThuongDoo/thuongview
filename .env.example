# ====== BẮT BUỘC để mọi người đăng nhập bằng Facebook ======
# Lấy ở developers.facebook.com → App của bạn → App settings → Basic
FB_APP_ID=
FB_APP_SECRET=

# Địa chỉ web mà mọi người truy cập (không có dấu / ở cuối).
# Redirect URI cần khai báo trong Facebook App = BASE_URL + /auth/callback
# Chạy thử trên máy mình thì để http://localhost:3000
BASE_URL=http://localhost:3000

# Chuỗi bí mật bất kỳ (dài, ngẫu nhiên) dùng để mã hoá token lưu trong database.
# Nếu để trống, app tự tạo file data/secret.key. ĐỪNG đổi sau khi đã có người đăng nhập.
APP_SECRET=

# ====== Tuỳ chọn ======
PORT=3000
# 127.0.0.1 = chỉ máy này / qua Cloudflare Tunnel hoặc Nginx. 0.0.0.0 = mở ra mạng ngoài.
HOST=127.0.0.1
FB_API_VERSION=v23.0
# Nếu App dùng "Facebook Login for Business" thì điền Configuration ID ở đây (khi đó bỏ qua scope)
FB_LOGIN_CONFIG_ID=
# Metric dùng để lấy view của reel
FB_REEL_METRICS=fb_reels_total_plays,blue_reels_play_count,post_impressions_unique
